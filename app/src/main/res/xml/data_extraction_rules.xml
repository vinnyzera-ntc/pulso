<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mesmas exclusões de backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reminders.xml" />
        <exclude domain="sharedpref" path="debug_seed.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reminders.xml" />
        <exclude domain="sharedpref" path="debug_seed.xml" />
    </device-transfer>
</data-extraction-rules>
